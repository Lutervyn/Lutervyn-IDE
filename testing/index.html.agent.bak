content: <!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login and Registration</title>
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
</head>

<body>
  <div class="container">
    <!-- Login Form -->
    <div class="form-box login">
      <form action="#">
        <h1>Login</h1>
        <div class="input-box">
          <input type="text" placeholder="username" required>
          <i class="bx bxs-user"></i>
        </div>

        <div class="input-box">
          <input type="password" placeholder="password" required>
          <i class="bx bxs-lock-alt"></i>
        </div>
        <div class="forgot-link">
          <a href="#">Forgot password</a>
        </div>
        <button type="submit" class="btn">Login</button>
        <p>or login with social platform</p>
        <div class="social-icons">
          <a href="#" aria-label="Login with Google"><i class="bx bxl-google"></i></a>
          <a href="#" aria-label="Login with Facebook"><i class="bx bxl-facebook"></i></a>

        </div>

      </form>
    </div>
    <!-- End Login Form -->

    <!-- Registration Form -->
    <div class="form-box register">
      <form action="#">
        <h1>Registration</h1>
        <div class="input-box">
          <input type="text" placeholder="Username" required>
          <i class="bx bxs-user"></i>
        </div>
        <div class="input-box">
          <input type="email" placeholder="Email" required>
          <i class="bx bxs-envelope"></i>
        </div>
        <div class="input-box">
          <input type="password" placeholder="Password" required>
          <i class="bx bxs-lock-alt"></i>
        </div>
        <button type="submit" class="btn">Register</button>
        <p>or register with social platforms</p>
        <div class="social-icons">
          <a href="#" aria-label="Register with Google"><i class="bx bxl-google"></i></a>
          <a href="#" aria-label="Register with Facebook"><i class="bx bxl-facebook"></i></a>
          <a href="#" aria-label="Register with GitHub"><i class="bx bxl-github"></i></a>
          <a href="#" aria-label="Register with LinkedIn"><i class="bx bxl-linkedin"></i></a>
        </div>
      </form>
    </div>
    <!-- End Registration Form -->

    <!-- Toggle Box -->
    <div class="toggle-box">
      <div class="toggle-panel toggle-left">
        <h1>Hello, Welcome!</h1>
        <p>Don't have an account?</p>
        <button class="btn register-btn">Register</button>
      </div>
      <div class="toggle-panel toggle-right">
        <h1>Welcome Back!</h1>
        <p>Already have an account?</p>
        <button class="btn login-btn">Login</button>
      </div>
    </div>
    <!-- End Toggle Box -->
  </div>
  <script src="index.js"></script>
  <!-- No backend logic is implemented, forms submit to the same page. -->
</body>

</html>